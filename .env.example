# CineForecast Environment Configuration
ENV=development
LOG_LEVEL=INFO

# Database
# For Docker / production PostgreSQL: postgresql://postgres:postgres@postgres:5432/cineforecast
# For local development without PostgreSQL service, SQLite fallback is supported:
DATABASE_URL=sqlite:///./cineforecast.db

# Redis
REDIS_URL=redis://localhost:6379/0

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Model Paths
MODEL_REGISTRY_DIR=./ml/models/registry
SHAP_CACHE_DIR=./ml/models/registry/shap_cache
PROCESSED_DATA_DIR=./data/processed
